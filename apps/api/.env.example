# Local PostgreSQL database settings (used by the db container)
POSTGRES_DB=salary_management
POSTGRES_USER=salary_app
POSTGRES_PASSWORD=salary_db

# Backend listens on port 3001; this host port is published by docker-compose.yml
PORT=3001

# API-to-PostgreSQL DSN: use the Compose service hostname "db" here.
DATABASE_DSN=postgresql://salary_app:salary_db@db:5432/salary_management?schema=public

# Browser origins allowed to call the API
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
